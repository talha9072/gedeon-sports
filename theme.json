{
  "$schema": "https://schemas.wp.org/wp/6.8/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "useRootPaddingAwareAlignments": false,
    "layout": {
      "contentSize": "1060px",
      "wideSize": "1280px"
    },
    "color": {
      "defaultPalette": false,
      "defaultGradients": false,
      "defaultDuotone": false,
      "palette": [
        { "slug": "page", "color": "#0B0C10", "name": "Page" },
        { "slug": "surface", "color": "#111217", "name": "Surface" },
        { "slug": "surface-raised", "color": "#16171C", "name": "Surface Raised" },
        { "slug": "footer", "color": "#08090D", "name": "Footer" },
        { "slug": "border", "color": "#23262C", "name": "Border" },
        { "slug": "red", "color": "#D51F35", "name": "Gedeon Red" },
        { "slug": "red-accent", "color": "#FF4A5E", "name": "Red Accent" },
        { "slug": "primary", "color": "#F4F4F5", "name": "Text Primary" },
        { "slug": "body", "color": "#D5D5DA", "name": "Text Body" },
        { "slug": "muted", "color": "#9A9AA3", "name": "Text Muted" },
        { "slug": "white", "color": "#FFFFFF", "name": "White" }
      ]
    },
    "spacing": {
      "defaultSpacingSizes": false,
      "units": ["px", "rem", "%", "vh", "vw"],
      "spacingSizes": [
        { "slug": "xs", "size": "8px", "name": "XS · 8" },
        { "slug": "sm", "size": "16px", "name": "SM · 16" },
        { "slug": "md", "size": "24px", "name": "MD · 24" },
        { "slug": "lg", "size": "40px", "name": "LG · 40" },
        { "slug": "xl", "size": "64px", "name": "XL · 64" },
        { "slug": "section", "size": "clamp(64px, 6.25vw, 120px)", "name": "Section · 64–120" }
      ]
    },
    "typography": {
      "defaultFontSizes": false,
      "fluid": false,
      "fontFamilies": [
        {
          "slug": "inter",
          "name": "Inter",
          "fontFamily": "Inter, ui-sans-serif, system-ui, -apple-system, \"Segoe UI\", sans-serif",
          "fontFace": [
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-latin-variable.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Inter",
              "fontStyle": "normal",
              "fontWeight": "400 700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/inter-latin-ext-variable.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        },
        {
          "slug": "titillium",
          "name": "Titillium Web",
          "fontFamily": "\"Titillium Web\", ui-sans-serif, system-ui, sans-serif",
          "fontFace": [
            {
              "fontFamily": "Titillium Web",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/titillium-web-700-latin.woff2"],
              "unicodeRange": "U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+0304, U+0308, U+0329, U+2000-206F, U+20AC, U+2122, U+2191, U+2193, U+2212, U+2215, U+FEFF, U+FFFD"
            },
            {
              "fontFamily": "Titillium Web",
              "fontStyle": "normal",
              "fontWeight": "700",
              "fontDisplay": "swap",
              "src": ["file:./assets/fonts/titillium-web-700-latin-ext.woff2"],
              "unicodeRange": "U+0100-02BA, U+02BD-02C5, U+02C7-02CC, U+02CE-02D7, U+02DD-02FF, U+0304, U+0308, U+0329, U+1D00-1DBF, U+1E00-1E9F, U+1EF2-1EFF, U+2020, U+20A0-20AB, U+20AD-20C4, U+2113, U+2C60-2C7F, U+A720-A7FF"
            }
          ]
        }
      ],
      "fontSizes": [
        { "slug": "small", "size": "13.2px", "name": "Small · 13" },
        { "slug": "caption", "size": "15.2px", "name": "Caption · 15" },
        { "slug": "body", "size": "17px", "name": "Body · 17" },
        { "slug": "intro", "size": "18.4px", "name": "Intro · 18" },
        { "slug": "body-lg", "size": "21px", "name": "Body Large · 21" },
        { "slug": "h4", "size": "22.4px", "name": "H4 · 22" },
        { "slug": "h3", "size": "27.5px", "name": "H3 · 27" },
        { "slug": "h2", "size": "51.5px", "name": "H2 · 51" }
      ]
    }
  },
  "styles": {
    "color": {
      "background": "var(--wp--preset--color--page)",
      "text": "var(--wp--preset--color--body)"
    },
    "spacing": {
      "blockGap": "0px",
      "padding": { "top": "0px", "right": "0px", "bottom": "0px", "left": "0px" }
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--inter)",
      "fontSize": "17px",
      "lineHeight": "28px"
    },
    "elements": {
      "link": {
        "color": { "text": "inherit" },
        "typography": { "textDecoration": "none" }
      },
      "heading": {
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--titillium)",
          "fontWeight": "700"
        },
        "color": { "text": "var(--wp--preset--color--primary)" }
      },
      "button": {
        "color": {
          "background": "var(--wp--preset--color--red)",
          "text": "var(--wp--preset--color--white)"
        },
        "typography": {
          "fontFamily": "var(--wp--preset--font-family--inter)",
          "fontSize": "15.6px",
          "fontWeight": "600",
          "lineHeight": "20px"
        },
        "border": { "radius": "999px" },
        "spacing": { "padding": { "top": "13px", "right": "26px", "bottom": "13px", "left": "26px" } }
      }
    }
  },
  "customTemplates": [
    { "name": "single-narrow", "title": "Single Post – Narrow", "postTypes": ["post"] },
    { "name": "page-policy", "title": "Policy", "postTypes": ["page"] }
  ],
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "post-grid", "title": "Post grid", "area": "uncategorized" }
  ]
}
